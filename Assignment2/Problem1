import java.util.*;

public class TrustedServers {
    static int N;
    static long K;
    static int[] keys;
    static ArrayList<Integer>[] adj;
    static int countTrusted = 0;

    static void dfs(int node, int parent, long currXor) {
        currXor ^= keys[node];  

        if (currXor >= K) {
            countTrusted++;
        }

        for (int child : adj[node]) {
            if (child != parent) {
                dfs(child, node, currXor);
            }
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        N = sc.nextInt();
        K = sc.nextLong();

        keys = new int[N + 1];
        for (int i = 1; i <= N; i++) {
            keys[i] = sc.nextInt();
        }

        adj = new ArrayList[N + 1];
        for (int i = 1; i <= N; i++) {
            adj[i] = new ArrayList<>();
        }

        for (int i = 0; i < N - 1; i++) {
            int u = sc.nextInt();
            int v = sc.nextInt();
            adj[u].add(v);
            adj[v].add(u);
        }

        dfs(1, -1, 0);

        System.out.println(countTrusted);
    }
}