import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();   
        long B = sc.nextLong(); 

        int[] arr = new int[N];

        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

        
        Arrays.sort(arr);

        int count = 0;

        
        for (int i = 0; i < N; i++) {
            if (B >= arr[i]) {
                B -= arr[i];
                count++;
            } else {
                break;
            }
        }

    
        System.out.println(count);
    }
}